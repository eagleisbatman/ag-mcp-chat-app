# FarmerChat Mobile App - Environment Variables
# Copy this file to .env and fill in your values
#
# For environment-specific configs, also see:
#   .env.development  - Development server URLs
#   .env.production   - Production server URLs

# ============================================
# CORE CONFIGURATION
# ============================================

# API Gateway Base URL (without /api/chat path)
EXPO_PUBLIC_API_BASE_URL=https://ag-mcp-api-gateway.up.railway.app

# API Key for the gateway (get from your backend admin)
EXPO_PUBLIC_API_KEY=your-api-key-here

# AI Services URL (optional - defaults to API_BASE_URL if not set)
# EXPO_PUBLIC_AI_SERVICES_URL=https://ag-mcp-ai-services.up.railway.app

# Environment identifier (production | development)
# This sets the default environment. Users can switch at runtime in dev builds.
EXPO_PUBLIC_ENV=production

# ============================================
# ENVIRONMENT URLS REFERENCE
# ============================================
#
# PRODUCTION:
#   API Gateway:  https://ag-mcp-api-gateway.up.railway.app
#   AI Services:  https://ag-mcp-ai-services.up.railway.app
#
# DEVELOPMENT:
#   API Gateway:  https://api-gateway-development-a0ed.up.railway.app
#   AI Services:  https://ag-mcp-ai-services-development.up.railway.app
#   AI (Groq):    https://ai-services-groq-development.up.railway.app
#   IVR:          https://ag-mcp-ivr-development.up.railway.app

# ============================================
# EAS BUILD SECRETS (for production builds)
# ============================================
# Run these commands to set secrets for EAS builds:
#
#   npx eas secret:create --name EXPO_PUBLIC_API_BASE_URL --value "https://ag-mcp-api-gateway.up.railway.app"
#   npx eas secret:create --name EXPO_PUBLIC_API_KEY --value "your-production-api-key"
#   npx eas secret:create --name EXPO_PUBLIC_ENV --value "production"
#
# List secrets: npx eas secret:list
# Delete secret: npx eas secret:delete --name SECRET_NAME

# ============================================
# DEVELOPMENT ONLY (for translation scripts)
# ============================================
# These are NOT bundled in the app - only used for running translation scripts locally
# GEMINI_API_KEY=your-gemini-api-key-for-translations
